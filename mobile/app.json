{
  "expo": {
    "name": "SabaiBiz",
    "slug": "sabaibiz",
    "scheme": "sabaibiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sabaibiz.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sabaibiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SabaiBiz uses the camera to photograph your invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SabaiBiz lets you pick invoice photos from your gallery."
        }
      ]
    ]
  }
}
